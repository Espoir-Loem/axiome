{
  "comment": "Patterns run on folded text (lowercase, no diacritics, straight apostrophes). First match wins.",
  "articles": [
    "a",
    "an",
    "the",
    "some",
    "this",
    "that",
    "these",
    "those"
  ],
  "pronouns": [
    "it",
    "he",
    "she",
    "him",
    "her",
    "they",
    "them",
    "this",
    "that",
    "its",
    "their",
    ""
  ],
  "stopwords": [
    "a",
    "an",
    "the",
    "of",
    "and",
    "or",
    "in",
    "on",
    "to",
    "for",
    "by",
    "with",
    "is",
    "are",
    "was",
    "be",
    "it",
    "its",
    "that",
    "this",
    "which",
    "what",
    "as",
    "at",
    "from"
  ],
  "level_signals": {
    "beginner": "\\b(?:more simply|simpler|explain simply|simply|in simple terms|like i'?m five|i'?m a beginner|beginner level|eli5)\\b",
    "expert": "\\b(?:expert level|professor level|advanced level|in detail|in depth|more technical|technically|i'?m an expert)\\b"
  },
  "intents": [
    [
      "greeting",
      "^(?:hello|hi|hey|good (?:morning|afternoon|evening))[ !.,]*$"
    ],
    [
      "thanks",
      "^(?:thanks|thank you|cheers)\\b[^?]*$"
    ],
    [
      "farewell",
      "^(?:bye|goodbye|see you|good night)\\b"
    ],
    [
      "user_name",
      "^(?:my name is|my name'?s|i'?m called|call me|you can call me) (?P<n>[^ ,.!?]+(?: [^ ,.!?]+)?)[ .!]*$"
    ],
    [
      "name",
      "(?:what'?s your name|what is your name|who should i call you|your name)"
    ],
    [
      "user_fine",
      "^(?:(?:i'?m )?(?:fine|good|great|ok|okay|well|not bad|doing well)(?:,? thanks| thank you)?(?:,? and you\\??)?|me too)[ !.]*$"
    ],
    [
      "how_are_you",
      "^(?:and )?(?:how are you|how'?s it going|how do you do|how are things|are you ok|you ok|how have you been)"
    ],
    [
      "ack",
      "^(?:ok|okay|alright|i see|got it|cool|nice|yes|no|yeah|sure)[ !.]*$"
    ],
    [
      "limits",
      "(?:what are your (?:limits|limitations|weaknesses)|your limitations|what can'?t you do|what are you bad at)"
    ],
    [
      "identity",
      "(?:who are you|what are you|what is axiome)"
    ],
    [
      "capabilities",
      "(?:what can you do|what do you do|what are you for)"
    ],
    [
      "confusion",
      "^(?:i don'?t understand|i do not understand|i didn'?t understand|i didn'?t get it|not clear|that'?s not clear|unclear)\\b"
    ],
    [
      "ask_user_name",
      "(?:what'?s my name|what is my name|do you know my name)"
    ],
    [
      "identity_ai",
      "(?:are you (?:an? )?(?:ai|artificial intelligence|robot|bot|human|machine|program))"
    ],
    [
      "help",
      "^(?:can you help(?: me)?|could you help(?: me)?|help me|i need help|help)\\b"
    ],
    [
      "date",
      "(?:what day is it|what'?s the date|what is the date|today'?s date|what day is today)"
    ],
    [
      "clock",
      "(?:what time is it|what'?s the time|current time)"
    ],
    [
      "forecast",
      "(?:weather|will it rain|forecast)"
    ],
    [
      "code_request",
      "^(?:write|code|implement|generate|create|make)(?: me)? (?:an?|the|some) (?:\\w+ )?(?:function|program|script|class|code|method)\\b"
    ],
    [
      "purpose",
      "^(?:which|what) (?:design )?pattern (?:should i use |to use |do i need )?(?:to|for) (?P<x>.+?)\\??$"
    ],
    [
      "compare",
      "^(?:what'?s |what is )?the difference between (?:an? |the )?(?P<x>.+?) and (?P<y>.+?)\\??$"
    ],
    [
      "why_is_a",
      "^why (?:is|are) (?P<x>.+?) (?P<ya>an? )(?P<y>.+?)\\??$"
    ],
    [
      "why_is_a",
      "^why are (?P<x>[a-z]+) (?P<y>[a-z]+)\\??$"
    ],
    [
      "why",
      "^(?:why|how come) (?P<q>.+?)\\??$"
    ],
    [
      "who",
      "^(?:who (?:is|was|were|are)) (?P<x>.+?)\\??$"
    ],
    [
      "check_property",
      "^(?:is|are) (?P<x>.+?) (?P<p>[a-z]+)\\?$"
    ],
    [
      "requirements",
      "^(?:does|do|can) (?P<x>.+?) (?:work|run|apply) (?:on|with|for) (?P<y>.+?)\\??$"
    ],
    [
      "requirements",
      "^what does (?P<x>.+?) (?:need|require)\\??$"
    ],
    [
      "properties",
      "^(?:what are )?(?P<x>its|their) (?:properties|characteristics)\\??$"
    ],
    [
      "properties",
      "^(?:what are )?(?:the )?(?:properties|characteristics) of (?P<x>.+?)\\??$"
    ],
    [
      "unit",
      "^(?:what is )?(?:the )?(?:si )?unit of (?P<x>.+?)\\??$"
    ],
    [
      "unit",
      "^what is (?P<x>.+?) measured in\\??$"
    ],
    [
      "complexity",
      "^(?:what is )?(?:the )?(?:time )?complexity of (?P<x>.+?)\\??$"
    ],
    [
      "members",
      "^(?:which|what) are the (?P<x>.+?)\\??$"
    ],
    [
      "members",
      "^(?:give (?:me )?|list )?(?:some )?examples? of (?P<x>.+?)\\??$"
    ],
    [
      "members",
      "^(?:give (?:me )?|show (?:me )?)(?:an |some )?examples?(?P<x>)\\??$"
    ],
    [
      "check_is_a",
      "^(?:is|are) (?P<x>.+?) (?P<ya>a |an )(?P<y>.+?)\\?$"
    ],
    [
      "definition",
      "^(?:explain |tell me )?what (?P<x>.+?) (?:is|are)\\??$"
    ],
    [
      "definition",
      "^(?:what is |what's |whats |what are |define |explain |tell me about |describe )(?P<x>.+?)\\??$"
    ],
    [
      "research",
      "^(?:search|look up|research)(?: for| about)? (?P<x>.+?)[.?]?$"
    ],
    [
      "follow_up",
      "^(?:and|what about|how about) (?P<x>.+?)\\?$"
    ],
    [
      "teach_is_a",
      "^(?!.*\\?)(?P<x>.+?) (?:is|are) (?P<ya>a |an )(?P<y>.+?)\\.?$"
    ]
  ],
  "level_only": "^(?:(?:explain|say|rephrase|tell me|continue)(?: it| that| again| me)*)?[ .!?]*$",
  "personal_markers": [
    "you",
    "your",
    "yours",
    "yourself",
    "i",
    "i'm",
    "me",
    "my",
    "mine"
  ],
  "greeting_prefix": "^(?:hello|hi|hey|good (?:morning|afternoon|evening))[ ,!.]+(?=\\S)",
  "laughter": "^(?:lol|lmao|rofl|xd|(?:ha){2,}h?|hehe)[ !.]*$",
  "filler": "^(?:hmm+|uh+|um+|meh|ah+|oh+)[ !.]*$",
  "operators": {
    "plus": "+",
    "minus": "-",
    "times": "*",
    "multiplied by": "*",
    "divided by": "/",
    "over": "/",
    "to the power of": "^",
    "squared": "^2",
    "mod": "%",
    "modulo": "%"
  },
  "arith_prefix": "^(?:what(?:'s| is)|how much is|calculate|compute|what does)\\s*",
