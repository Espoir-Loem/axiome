      "^(?:quelles sont |c'est quoi )?(?:les )?(?:proprietes|caracteristiques) d(?:e |u |es |')(?P<x>.+?)\\??$"
    ],
    [
      "unit",
      "^(?:quelle est |c'est quoi )?l'unite(?: si)? d(?:e |u |es |')(?P<x>.+?)\\??$"
    ],
    [
      "unit",
      "^(?:quelle est )?l'unite(?: si)? d(?:e |u |es |')(?P<x>.+?)\\??$"
    ],
    [
      "unit",
      "^en quoi se mesure (?P<x>.+?)\\??$"
    ],
    [
      "complexity",
      "^(?:quelle est |c'est quoi )?la complexite d(?:e |u |es |')(?P<x>.+?)\\??$"
    ],
    [
